# .env.example — copy to .env and fill in real values before running.
# Never commit .env to version control.

# 32-byte AES-256 key, base64-encoded.
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Optional: separate HMAC key (base64-encoded). If omitted, derived from ENCRYPTION_KEY.
# HMAC_KEY=REPLACE_WITH_BASE64_ENCODED_HMAC_KEY

# Optional: override the default database path (ledger.db in repo root).
# DB_PATH=/path/to/custom/ledger.db

